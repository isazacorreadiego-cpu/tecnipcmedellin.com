# Cabeceras HTTP para Cloudflare Pages (también las lee Netlify).
# GitHub Pages ignora este archivo: allí no hay forma de configurar cabeceras.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Las páginas se revalidan siempre. Con ETag el costo es mínimo y garantiza
# que un cambio de precio o de teléfono se vea de inmediato.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Las imágenes casi no cambian: un mes de caché.
/assets/img/*
  Cache-Control: public, max-age=2592000

# OJO: estos dos archivos NO llevan el contenido en el nombre (no son
# estilos.a1b2c3.css), así que una caché larga dejaría a los visitantes
# con la versión vieja durante días. Una hora, y luego revalidan.
/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate
